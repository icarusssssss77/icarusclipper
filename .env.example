# Copy to .env and fill in. Never commit .env. Everything here is free.

# Free AI for clip picks + hooks (Gemini first, Groq as backup)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys  (optional)

# TikTok Content Posting API (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Graph API (IG Business/Creator account linked to a Facebook Page)
IG_USER_ID=
IG_ACCESS_TOKEN=
