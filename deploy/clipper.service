[Unit]
Description=GTA 6 live clipper
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP__
Environment=PATH=__APP__/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP__/.venv/bin/python -m clipper live
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
